LIGHTING_STORAGE=embedded-surrealkv
LIGHTING_SURREAL_PATH=.lighting-data/surrealkv
# The endpoint and credentials below are used only with
# LIGHTING_STORAGE=remote-surreal.
LIGHTING_SURREAL_ENDPOINT=ws://127.0.0.1:8000
LIGHTING_SURREAL_NAMESPACE=lantern_keeper
LIGHTING_SURREAL_DATABASE=lighting_dev
LIGHTING_SURREAL_USERNAME=root
LIGHTING_SURREAL_PASSWORD=root
LIGHTING_HOST=127.0.0.1
LIGHTING_PORT=4317
RUST_LOG=info

# Optional sponsor/demo integrations. Keep credentials local and unlogged.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=
TAVILY_API_KEY=
LANTERN_DEMO_MODE=false
LANTERN_AUTH_SESSION_SECRET=
LANTERN_RECEIPT_SIGNING_KEY_PATH=
