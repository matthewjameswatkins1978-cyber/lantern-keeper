{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lantern-keeper-mcp",
  "main": "src/lib.rs",
  "compatibility_date": "2026-11-01",
  "build": {
    "command": "worker-build --release"
  },
  "d1_databases": [
    {
      "binding": "LANTERN_DB",
      "database_name": "lantern-keeper",
      "database_id": "10d518bf-6c09-4800-8d4f-56950a0e0ea3"
    }
  ],
  "observability": {
    "enabled": false
  }
}
